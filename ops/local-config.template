# Local Docker Compose settings. Copy this file to .env on your own computer before starting.
MONGO_INITDB_ROOT_USERNAME=vaultadmin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-unique-local-password
MONGO_DATABASE=knowledge_vault
REDIS_URL=redis://redis:6379
MINIO_ROOT_USER=vaultminio
MINIO_ROOT_PASSWORD=replace-with-a-unique-local-password
MINIO_BUCKET=knowledge-vault
MINIO_INTERNAL_ENDPOINT=minio
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8787
WEB_PORT=5173
IMPORT_DIR=./local-imports
BACKUP_DIR=./backups
DOCLING_MAX_FILE_SIZE=1073741824
DOCLING_MAX_NUM_PAGES=2000
DOCLING_WORKERS=1
# For ARM64 Macs, set TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TEI_MAX_CONCURRENT_REQUESTS=2
TEI_MAX_CLIENT_BATCH_SIZE=8
RERANKER_MAX_CONCURRENT_REQUESTS=1
RERANKER_MAX_CLIENT_BATCH_SIZE=12
PUBLIC_CAPTURE_MAX_RESPONSE_BYTES=8388608
PUBLIC_CAPTURE_MAX_TEXT_CHARS=250000
PUBLIC_CAPTURE_MIN_INTERVAL_SECONDS=2
